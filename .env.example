# Copy this file to .env.local and fill in YOUR values. Never commit .env.local.
# Placeholder names only - no real values belong in this file.

# Supabase project URL and public anon key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key. Never expose it in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret (at least 32 random characters) used to encrypt share tokens.
# Generate one with: openssl rand -base64 48
SHARE_TOKEN_SECRET=

# Public base URL used when building customer links, no trailing slash.
# In Codespaces use the forwarded port URL, for example https://your-codespace-3000.app.github.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: only for the integration tests (use a separate test project, never production)
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=

# Company contact details. These already default to JNectar's verified details in lib/site.ts.
# Set a variable only to override it. Leave empty to keep the default.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Optional, shown only when filled in (never invented)
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# Optional email alerts for contact-form messages (messages are always saved in Supabase).
# Needs an account with an email provider (Resend). Leave empty to disable. Server-only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Platform owner: comma-separated emails that may see real platform statistics (total users,
# subscribers) on their dashboard. Server-only. Leave empty to hide the statistics from everyone.
ADMIN_EMAILS=
# Show real user and agreement counts on the public home page only after this many real users.
# Default 25. Set 0 to show them always (they are still real numbers).
PUBLIC_STATS_MIN_USERS=

# Sign-in buttons for Google and GitHub appear ONLY when listed here AND switched on in Supabase
# (Authentication, Providers). Example: google,github. Leave empty to hide them.
NEXT_PUBLIC_OAUTH_PROVIDERS=
# Company website shown in the footer and contact page (defaults to https://jnectar.tech)
NEXT_PUBLIC_COMPANY_WEBSITE=
# Exchange-rate range used only for the approximate naira amounts next to dollar prices
NEXT_PUBLIC_NGN_RATE_LOW=
NEXT_PUBLIC_NGN_RATE_HIGH=
